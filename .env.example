# Server-only Supabase configuration. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PRIVATE_INQUIRY_ENABLED=false
# UI build gate. Keep false until the server path and Firewall are verified.
NEXT_PUBLIC_PRIVATE_INQUIRY_ENABLED=false

# Optional: override AdSense publisher ID (fallback: ca-pub-8422791508684989).
NEXT_PUBLIC_ADSENSE_CLIENT=
